## 📄 1. AI_HELPER.md (API Core Integration Layer)

### Purpose
Handles direct, secure communication with the Claude 3.5 Sonnet API. It takes raw text inputs, structures a strict system prompt to enforce clean JSON delivery, and handles background error parsing.

### ⚙️ Production Code: `utils/ai_helper.py`
*Status: New File*

```python
import streamlit as st
from anthropic import Anthropic
import json

def get_claude_client():
    """Initializes the Anthropic client using the secure system state key."""
    api_key = st.secrets.get("ANTHROPIC_API_KEY", "")
    if not api_key and "api_key" in st.session_state:
        api_key = st.session_state.api_key
    return Anthropic(api_key=api_key)

def generate_summary_and_quiz(text_input):
    """Sends user notes to Claude and extracts a clean summary and 5 structured MCQs JSON payload."""
    client = get_claude_client()
    
    system_prompt = (
        "You are an elite educational assistant tool. Analyze the provided text and output a strict JSON response. "
        "Do not include any conversational introductory text outside the JSON wrapper. The JSON must follow this structure:\n"
        "{\n"
        "  \"summary\": \"[Bullet points summary of the text]\",\n"
        "  \"questions\": [\n"
        "    {\n"
        "      \"id\": 1,\n"
        "      \"question\": \"Question text?\",\n"
        "      \"options\": [\"Option A\", \"Option B\", \"Option C\", \"Option D\"],\n"
        "      \"answer\": \"Correct Option Text\"\n"
        "    }\n"
        "  ]\n"
        "}\n"
        "Generate exactly 5 distinct multiple-choice questions based on the text context."
    )
    
    try:
        response = client.messages.create(
            model="claude-3-5-sonnet-20240620",
            max_tokens=2500,
            system=system_prompt,
            messages=[{"role": "user", "content": f"Analyze this text:\n\n{text_input}"}]
        )
        raw_text = response.content.text.strip()
        return json.loads(raw_text)
    except Exception as e:
        return {"error": str(e)}
```

