## 📄 1. QUIZ_INTERACTION.md (Form Protection & Grading System)

### Purpose
Implements a strict state-persisted user form architecture. It allows users to answer multiple-choice questions natively without page-reload friction, running entirely on a free-tier simulator fallback option if no paid keys are configured.

### ⚙️ Production Code Reference: `components/quiz_view.py`
*Status: Replacement / Update File*

```python
import streamlit as st
from utils.ai_helper import generate_summary_and_quiz

def show_quiz_page():
    st.subheader("💡 Paste Your Notes to Begin Learning")
    
    api_key_input = st.text_input(
        "Anthropic API Key (Optional - Leave blank to use Free Simulator Mode):", 
        type="password"
    )
    if api_key_input:
        st.session_state.api_key = api_key_input
        
    user_text = st.text_area("Paste study material, notes, or article content here:", height=200)
    
    if st.button("✨ Generate Summary & Quiz", use_container_width=True):
        if not user_text.strip():
            st.warning("Please insert valid text notes first.")
            return
            
        with st.spinner("Processing study assets..."):
            result = generate_summary_and_quiz(user_text)
            
            if "error" in result:
                st.error(f"Execution Failure: {result['error']}")
            else:
                st.session_state.quiz_data = result
                st.session_state.user_answers = {}
                st.session_state.quiz_submitted = False
                st.success("Successfully generated educational assets!")

    if "quiz_data" in st.session_state:
        data = st.session_state.quiz_data
        
        st.markdown("### 📝 Smart AI Summary")
        st.info(data.get("summary", "No summary processed."))
        
        st.markdown("### ✍️ Practice Evaluation Quiz")
        questions = data.get("questions", [])
        
        with st.form(key="interactive_quiz_form"):
            for idx, q in enumerate(questions):
                st.write(f"**Q{idx+1}: {q['question']}**")
                
                user_choice = st.radio(
                    "Choose the correct option:", 
                    q["options"], 
                    key=f"q_choice_{q['id']}"
                )
                st.session_state.user_answers[q["id"]] = user_choice
                st.markdown("---")
                
            submit_button = st.form_submit_button(label="🚀 Submit Quiz Answers", use_container_width=True)
            
            if submit_button:
                st.session_state.quiz_submitted = True

        if st.session_state.get("quiz_submitted", False):
            score = 0
            st.markdown("### 📊 Evaluation Report")
            for idx, q in enumerate(questions):
                selected = st.session_state.user_answers.get(q["id"])
                correct = q["answer"]
                
                if selected == correct:
                    score += 1
                    st.success(f"**Question {idx+1}: Correct!** You selected: {selected}")
                else:
                    st.error(f"**Question {idx+1}: Incorrect.** Chosen: {selected} | Correct Target: {correct}")
            
            st.metric(label="Your Final Score", value=f"{score} / {len(questions)}")
```

